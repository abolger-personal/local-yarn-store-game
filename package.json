{
  "name": "yarnstore",
  "version": "1.0.0",
  "private": true,
  "description": "LYS - local yarn store concept viewers",
  "scripts": {
    "lint": "eslint --cache --cache-location node_modules/.cache/eslint/ .",
    "lint:fix": "eslint . --fix",
    "serve": "python3 serve.py 8765",
    "typecheck": "tsc -p jsconfig.json",
    "selfcheck": "node tools/run-tests.mjs fast",
    "check": "npm run lint && npm run typecheck && npm run selfcheck && node tools/selectors.mjs && node tools/sideeffects.mjs",
    "check:slow": "node tools/run-tests.mjs slow",
    "check:all": "npm run check && npm run check:slow",
    "check:full": "FULL=1 SEEDS=50 npm run check:all"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "eslint-import-resolver-node": "^0.4.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-unicorn": "^74.0.0",
    "globals": "^17.12.0",
    "three": "0.186.1",
    "trystero": "0.26.0",
    "typescript": "^7.0.2"
  }
}
